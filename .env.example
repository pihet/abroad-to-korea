# 공공데이터포털 인증키 (포털 표시값 그대로, 재인코딩하지 않음). 실제 값은 .env 에만 넣고 커밋하지 않는다
TOUR_API_KEY=
# 키가 더 있으면 차례로 추가: 매일 수집이 한 키의 하루 한도가 차면 다음 키로 넘어간다
TOUR_API_KEY_2=

# Docker Compose 내부 비밀번호. 실제 운영값은 반드시 긴 무작위 값으로 바꾼다.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5434/abroad_to_korea
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=abroad-to-korea

PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false

# Resend 트랜잭션 메일. 도메인 인증 전에는 onboarding@resend.dev로 계정 소유자에게만 테스트할 수 있다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Abroad to Korea <onboarding@resend.dev>
RESEND_REPLY_TO=
EMAIL_WORKER_POLL_SECONDS=2

# Google/Kakao 개발자 콘솔의 callback URL:
# {PUBLIC_BASE_URL}/api/auth/oauth/{google|kakao}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
